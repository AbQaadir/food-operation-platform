{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductUpdatedEvent",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string",
      "format": "uuid"
    },
    "sku": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "productId",
    "sku",
    "name",
    "price",
    "active"
  ]
}